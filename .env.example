# Copy this file to .env and fill in your credentials
# Never commit .env to git

# ExpiredDomains.net — https://www.expireddomains.net/register/
EXPIREDDOMAINS_USER=yourusername
EXPIREDDOMAINS_PASS=yourpassword
EXPIREDDOMAINS_SESSION=paste-sessionid-cookie-here   # MFA accounts only

# ICANN CZDS — https://czds.icann.org/home
CZDS_USER=your@email.com
CZDS_PASS=yourpassword
CZDS_TOKEN=paste-full-jwt-here   # 500+ chars, from browser DevTools